{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gridlock": {
      "root": "gridlock",
      "framework": "create-react-app"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ]
}